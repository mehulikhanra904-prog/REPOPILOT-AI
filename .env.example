# Optional: increases the GitHub API rate limit and enables private repositories.
GITHUB_TOKEN=

# Keep all LLM credentials on the FastAPI server. The browser only receives answers.
# Supported values: none, openai, anthropic
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_TIMEOUT_SECONDS=20
ANALYSIS_CACHE_TTL_SECONDS=300
ANALYSIS_CACHE_MAX_ENTRIES=32
